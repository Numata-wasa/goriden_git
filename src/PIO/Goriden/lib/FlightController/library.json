{
  "name": "FlightController",
  "version": "2.0.0",
  "description": "Rocket flight control system with quaternion-based attitude estimation, altitude integration (ZUPT), and PID control for ESP32",
  "keywords": [
    "rocket",
    "flight control",
    "IMU",
    "quaternion",
    "attitude estimation",
    "altitude",
    "PID",
    "BMI270",
    "ESP32",
    "complementary filter",
    "ZUPT"
  ],
  "authors": [
    {
      "name": "Original Author",
      "maintainer": true
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/your-repo/FlightController.git"
  },
  "license": "MIT",
  "frameworks": ["arduino"],
  "platforms": ["espressif32"],
  "dependencies": [
    {
      "name": "BMI2_BMM1",
      "version": "*"
    }
  ],
  "export": {
    "include": [
      "FlightController.h",
      "FlightController.cpp",
      "README.md",
      "examples"
    ]
  },
  "examples": [
    {
      "name": "Basic Usage",
      "base": "examples",
      "files": ["example_basic.cpp"]
    },
    {
      "name": "FreeRTOS Integration",
      "base": "examples",
      "files": ["example_freertos.cpp"]
    }
  ],
  "build": {
    "flags": ["-Wno-unused-variable"],
    "libArchive": false
  }
}
